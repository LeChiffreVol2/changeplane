# GitHub App client credentials. The App may be installed on GitHub.com personal accounts
# and organizations. Request Actions and Administration read plus Contents, Pull requests,
# Workflows, and Checks write. Actions Secrets write is additionally required for BYOK and Full
# provisioning. Leave GITHUB_APP_SLUG unset only for a deliberate local broad-OAuth observe fallback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Requests public repository-scoped onboarding. This candidate keeps customer access paused until
# the candidate PostgreSQL journal has live durability/serialized-canary evidence and commercial
# runtime integration is implemented and verified. No flag overrides those capability gates.
# Signed-out replay remains available.
CHANGEPLANE_SELF_SERVE_ENABLED=false

# Both alpha and hosted self-service require legal approval for the exact protected Vercel Git
# source SHA. Requested mode stays visible with an accessBlock when blocked. Approval requires
# the reviewed legal pack; never use these flags to represent an unreviewed draft as effective.
CHANGEPLANE_LEGAL_RELEASE_APPROVED=false
CHANGEPLANE_LEGAL_RELEASE_APPROVED_RELEASE=

# Invite-only Design Partner Alpha scope. Supply a JSON array of one to five exact repositories,
# normally one per approved organization. When present, this takes precedence over the disposable
# canary and keeps every repository read/write and Guard publication outside the list fail-closed.
# Requires distinct Guard/Installer principals plus live-verified journal publication.
# Leave unset until those capabilities, the signed order form and repository owner approval exist.
CHANGEPLANE_ALPHA_REPOSITORIES_JSON=

# Generate at least 32 random characters. Rotating this invalidates every web session.
CHANGEPLANE_SESSION_SECRET=

# Exact HTTPS origin without a path, query, or trailing slash.
CHANGEPLANE_APP_ORIGIN=https://changeplane.example.com

# Exact target for controlled-canary mode only. Self-serve mode verifies each App installation.
CHANGEPLANE_CANARY_REPOSITORY=your-user/changeplane-disposable-canary

# Non-secret identities required by scripts/provision-repair-canary.mjs. Copy the exact repository
# and installation IDs plus every Ruleset-required behavioral Check's GitHub integration ID. The
# script also uses CHANGEPLANE_GUARD_APP_ID below and refuses activation when any binding drifts.
CHANGEPLANE_CANARY_REPOSITORY_ID=
CHANGEPLANE_CANARY_INSTALLATION_ID=
CHANGEPLANE_CANARY_EVIDENCE_CHECKS_JSON='[{"name":"CI / verify","integrationId":123456}]'
CHANGEPLANE_ENABLE_REPAIR=false

# Dedicated repair controller. In controlled-canary mode the repair repository must equal the
# canary exactly. In self-serve mode repository authority comes from the verified App installation.
# Keep the global switch false until the disposable release canary passes.
CHANGEPLANE_REPAIR_REPOSITORY=your-user/changeplane-disposable-canary
CHANGEPLANE_REPAIR_ENABLED=false
CHANGEPLANE_REPAIR_GENERATION=1

# Repair-controller GitHub App credentials. The App ID and private key must belong to
# GITHUB_APP_SLUG and its repository-scoped installation. Keep the PEM server-side only.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Dedicated guard-publisher GitHub App credentials. This App requires Actions, Contents, and Pull
# requests read plus Checks write; read-only and Checks-write tokens are minted separately for one
# repository. The ID, slug, and private key must identify the same reviewed App, distinct from
# the Installer App for this journal candidate. Shared-principal reuse cannot satisfy hosted
# journal configuration. Keep the PEM server-side only.
CHANGEPLANE_GUARD_REUSE_GITHUB_APP=false
CHANGEPLANE_GUARD_APP_ID=
CHANGEPLANE_GUARD_APP_SLUG=
CHANGEPLANE_GUARD_APP_PRIVATE_KEY=

# Candidate authority journal: required for EVERY Guard write when VERCEL=1, including owner canary.
# Missing/disabled/invalid configuration stops publication; there is no unjournaled fallback.
# Before promotion: separately provision/enroll the authority database and new Guard App; prove
# tenant/role isolation, durable ownership and zero-loss recovery (or halt/new-principal recovery).
# URL must use postgres/postgresql with exactly one query pair: sslmode=verify-full, not require.
# Duplicate/extra options, fragments, and encoded hosts are rejected. Keep the URL server-side.
# EPOCH is the approved enrollment UUID. VERIFIED_RELEASE is the exact 40-character protected
# VERCEL_GIT_COMMIT_SHA, also bound in the database enrollment. Configuration alone is not live proof.
# Non-hosted legacy fixtures must OMIT all four variables; even blank entries request the journal.
CHANGEPLANE_GUARD_JOURNAL_ENABLED=false
CHANGEPLANE_GUARD_JOURNAL_DATABASE_URL=
CHANGEPLANE_GUARD_JOURNAL_EPOCH=
CHANGEPLANE_GUARD_JOURNAL_VERIFIED_RELEASE=

# Independent 32+ character server master secret. Never copy this value into GitHub.
# The repository receives only a repository-bound derived HMAC as an Actions Secret.
CHANGEPLANE_CONTROLLER_SECRET=

# Private managed-execution canary only. Keep this server-side; never copy it into a customer repository.
CHANGEPLANE_MANAGED_OPENAI_API_KEY=

# Candidate commercial admission store, separate from the authority journal database.
# When enabled, new Guard evaluations require an operator-enrolled finite Verify Lite PR
# pilot contract (003_pilot_admission.sql). Owner canary may omit commercial admission;
# customer rollout still requires all independent gates and commercial readiness stays false.
# Denial or outage blocks the Guard; completion and recovery do not consume another unit.
# URL accepts only sslmode=verify-full. VERIFIED_RELEASE binds the exact protected source SHA.
# Keep disabled until role/isolation, retention/replay, metering, cost and incident drills pass.
CHANGEPLANE_COMMERCIAL_STORE_ENABLED=false
CHANGEPLANE_COMMERCIAL_STORE_VERIFIED_RELEASE=
CHANGEPLANE_DATABASE_URL=

# Structured metadata only; request bodies, tokens, and provider keys are never logged.
CHANGEPLANE_LOG_REQUESTS=true
