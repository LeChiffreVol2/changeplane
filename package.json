{
  "name": "changeplane",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 src/lib/*.test.js action/*.test.js server/*.test.js tests/*.test.js",
    "test:guard-journal": "node scripts/test-guard-journal-postgres.mjs",
    "test:pilot-admission": "node scripts/test-pilot-admission-postgres.mjs",
    "test:postgres-tls": "node scripts/test-postgres-tls.mjs",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm test && npm run prove:origin-boundary && npm run build && npm run audit:public && npm run audit:claims",
    "prove:origin-boundary": "node scripts/prove-origin-boundary.mjs",
    "audit:public": "node scripts/audit-public-data.mjs",
    "audit:claims": "node scripts/audit-release-claims.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "report:launch": "node scripts/report-launch.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.18 <23"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "libsodium-wrappers": "^0.8.4",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
